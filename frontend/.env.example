# Local frontend reference. Copy to .env.local only to override defaults.
# Restart npm start after changes. These values are public; never add secrets.
# Use an origin without /api or a trailing slash.
REACT_APP_API_BASE_URL=http://localhost:8080
# SockJS expects an HTTP(S) URL, including the /ws endpoint.
REACT_APP_WS_URL=http://localhost:8080/ws
