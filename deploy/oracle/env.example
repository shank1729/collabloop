# Copy to deploy/oracle/.env on the VM; chmod 600 .env. Never commit real values.
# Bare hostname only: no scheme, path, slash at the end, spaces, or port.
# With no purchased domain, substitute the VM's real public IPv4 below.
APP_HOST=collab.203-0-113-10.sslip.io
# Reuse the existing Neon database and its provider-issued TLS connection string.
DATABASE_URL=postgresql://USER:URL_ENCODED_PASSWORD@NEON_HOST/DATABASE?sslmode=require
# Use a generated random key; the production backend rejects example values.
JWT_SECRET=replace-with-a-generated-random-secret-at-least-32-bytes
JWT_EXPIRATION_MS=86400000
AUTH_RATE_LIMIT_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_CLIENTS=10000
