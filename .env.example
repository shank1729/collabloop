# Local backend reference. Spring does not automatically read this file.
# Set these in the launching PowerShell session or Eclipse Run Configuration.
# See DEPLOYMENT.md for complete instructions.
DB_URL=jdbc:postgresql://localhost:5432/collabdb
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-local-postgres-password
# For cloud deployments, use .env.production.example as the reference instead.
# DATABASE_URL takes precedence over DB_URL; choose one connection style.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
JWT_SECRET=local-development-only-secret-at-least-32-bytes
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:3000
PORT=8080
# Shared budget across login + registration, per connection IP.
AUTH_RATE_LIMIT_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_CLIENTS=10000
# Ignore forwarding headers unless a verified reverse proxy is configured.
SERVER_FORWARD_HEADERS_STRATEGY=none
