# Backend production reference; replace placeholders in Render's environment UI.
# Do not copy these into frontend settings. Do not set Render's PORT manually.
SPRING_PROFILES_ACTIVE=prod
DATABASE_URL=postgresql://USER:URL_ENCODED_PASSWORD@NEON_HOST/DATABASE?sslmode=require
JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-bytes
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=https://realtime-collab-frontend.onrender.com
# See DEPLOYMENT.md before enabling proxy-derived client IPs on Render.
AUTH_RATE_LIMIT_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_CLIENTS=10000
SERVER_FORWARD_HEADERS_STRATEGY=none
